{
  "$schema": "riescade-emulator-schema-v1",
  "id": "retroarchcc",
  "name": "RetroArch CC",
  "description": "Configurações do RetroArch CC utilizado pelo Windows 98.",
  "icon": "retroarch",
  "configFiles": [
    {
      "path": "emulators/retroarchCC/retroarch.cfg",
      "format": "cfg"
    }
  ],
  "globalMappings": {
    "fullscreen": { "configKey": "fullscreen", "globalKey": "fullscreen" },
    "aspect_ratio": { "configKey": "aspect_ratio", "globalKey": "aspect_ratio" },
    "video_driver": { "configKey": "video_driver", "globalKey": "video_driver" },
    "audio_driver": { "configKey": "audio_driver", "globalKey": "audio_driver" },
    "vsync": { "configKey": "vsync", "globalKey": "vsync" }
  },
  "groups": [
    {
      "id": "video",
      "title": "Vídeo",
      "icon": "monitor",
      "order": 1,
      "options": [
        {
          "id": "fullscreen",
          "label": "Tela cheia",
          "type": "toggle",
          "default": "auto",
          "configKey": "fullscreen",
          "inheritsGlobal": "fullscreen"
        },
        {
          "id": "aspect_ratio",
          "label": "Proporção de tela",
          "type": "select",
          "default": "auto",
          "configKey": "aspect_ratio",
          "inheritsGlobal": "aspect_ratio",
          "values": [
            { "label": "AUTO", "value": "auto" },
            { "label": "4:3", "value": "4:3" },
            { "label": "16:9", "value": "16:9" },
            { "label": "Esticar", "value": "stretch" }
          ]
        },
        {
          "id": "vsync",
          "label": "Sincronização vertical",
          "type": "toggle",
          "default": "auto",
          "configKey": "vsync",
          "inheritsGlobal": "vsync"
        },
        {
          "id": "integer_scale",
          "label": "Escala inteira",
          "type": "toggle",
          "default": "auto",
          "configKey": "integer_scale"
        }
      ]
    },
    {
      "id": "drivers",
      "title": "Drivers",
      "icon": "cpu",
      "order": 2,
      "options": [
        {
          "id": "video_driver",
          "label": "Driver de vídeo",
          "type": "select",
          "default": "auto",
          "configKey": "video_driver",
          "inheritsGlobal": "video_driver",
          "values": [
            { "label": "AUTO", "value": "auto" },
            { "label": "Direct3D", "value": "d3d" },
            { "label": "OpenGL", "value": "gl" },
            { "label": "GDI", "value": "gdi" }
          ]
        },
        {
          "id": "audio_driver",
          "label": "Driver de áudio",
          "type": "select",
          "default": "auto",
          "configKey": "audio_driver",
          "inheritsGlobal": "audio_driver",
          "values": [
            { "label": "AUTO", "value": "auto" },
            { "label": "DirectSound", "value": "dsound" },
            { "label": "XAudio", "value": "xaudio" },
            { "label": "Sem áudio", "value": "null" }
          ]
        }
      ]
    },
    {
      "id": "input",
      "title": "Controles",
      "icon": "gamepad2",
      "order": 3,
      "options": [
        {
          "id": "input_autodetect",
          "label": "Detectar controles automaticamente",
          "type": "toggle",
          "default": "true",
          "configKey": "input_autodetect"
        }
      ]
    }
  ]
}
